+const compCache = new WeakMap<Geo, Int32Array>()
+/** Connected components of the coarse walk grid under the same moves A* uses (8 neighbours, no corner cutting). */
+function components(g: Geo): Int32Array {
+  let comp = compCache.get(g)
+  if (comp) return comp
+  const n = g.cnx * g.cny
+  comp = new Int32Array(n).fill(-1)
+  const stack: number[] = []
+  let label = 0
+  for (let s0 = 0; s0 < n; s0++) {
+    if (g.blocked[s0] || comp[s0] >= 0) continue
+    comp[s0] = label; stack.push(s0)
+    while (stack.length) {
+      const c = stack.pop()!, ci = c % g.cnx, cj = Math.floor(c / g.cnx)
+      for (let dj = -1; dj <= 1; dj++) for (let di = -1; di <= 1; di++) {
+        if (!di && !dj) continue
+        const i2 = ci + di, j2 = cj + dj
+        if (i2 < 0 || j2 < 0 || i2 >= g.cnx || j2 >= g.cny) continue
+        const k = j2 * g.cnx + i2
+        if (g.blocked[k] || comp[k] >= 0) continue
+        if (di && dj && (g.blocked[cj * g.cnx + i2] || g.blocked[j2 * g.cnx + ci])) continue
+        comp[k] = label; stack.push(k)
+      }
+    }
+    label++
+  }
+  compCache.set(g, comp)
+  return comp
