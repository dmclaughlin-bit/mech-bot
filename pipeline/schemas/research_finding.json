{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "research_finding.json",
 "title": "research_finding",
 "description": "One claim from Diego's (or other) outside research. Ingested as evidence_class research_claim, never as proven mechanics.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "claim",
  "topic",
  "sources",
  "confidence",
  "suggested_change"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^EV-R-[0-9]{4}$"
  },
  "claim": {
   "type": "string",
   "minLength": 10
  },
  "topic": {
   "type": "string",
   "enum": [
    "strategy_mechanics",
    "top_team_behavior",
    "resource_upgrade",
    "our_weakness",
    "untested_opportunity",
    "contradiction"
   ]
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "ref"
    ],
    "properties": {
     "ref": {
      "type": "string",
      "minLength": 3
     },
     "kind": {
      "type": "string",
      "enum": [
       "repo",
       "doc",
       "protocol",
       "video",
       "leaderboard",
       "watch_stream",
       "other"
      ]
     },
     "quote": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "is_guess": {
   "type": "boolean"
  },
  "verification": {
   "type": "string",
   "enum": [
    "unverified",
    "verified",
    "refuted"
   ]
  },
  "failure_classes": {
   "type": "array",
   "description": "Diego's failure taxonomy (research/intake/diego-research-1105.md E2). Suspected, not proven, unless basis says otherwise.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "class",
     "confidence"
    ],
    "properties": {
     "class": {
      "type": "string",
      "enum": [
       "NAV_COLLISION",
       "NAV_STUCK",
       "NAV_BAD_ROUTE",
       "ZONE_LATE",
       "MULTI_ENEMY_TRAP",
       "COVER_FAILURE",
       "REGEN_RESET",
       "OVER_AGGRESSION",
       "UNDER_AGGRESSION",
       "AIM_WEAPON",
       "RESOURCE_TRAP",
       "COMPUTE_FAILURE",
       "UNKNOWN"
      ]
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "basis": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "sample_size": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 0
  },
  "suggested_change": {
   "type": "string"
  },
  "mechanism": {
   "type": [
    "string",
    "null"
   ]
  },
  "expected_gain": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0,
   "maximum": 3
  },
  "effort": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 1,
   "maximum": 5
  },
  "regression_risk": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0,
   "maximum": 1
  },
  "related_rule_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "related_experiments": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "contradicts": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "keywords": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "author": {
   "type": [
    "string",
    "null"
   ]
  },
  "submitted_at": {
   "type": [
    "string",
    "null"
   ]
  },
  "synthetic": {
   "type": "boolean"
  },
  "evidence_class": {
   "type": "string",
   "enum": [
    "research_claim"
   ]
  },
  "dedupe_hash": {
   "type": "string"
  },
  "intake_file": {
   "type": "string"
  },
  "ingested_at": {
   "type": "string"
  }
 }
}
